{
  "name": "edunancial-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "curriculum:import": "node scripts/curriculum/import.mjs",
    "curriculum:validate": "node scripts/curriculum/validate.mjs",
    "curriculum:audit": "node scripts/curriculum/audit.mjs",
    "curriculum:localization": "node scripts/curriculum/localization-report.mjs",
    "curriculum:localization:global": "node scripts/curriculum/global-localization.mjs",
    "curriculum:translation-workqueue": "npm run curriculum:localization:global && node scripts/curriculum/translation-workqueue.mjs",
    "curriculum:translation-quality": "node scripts/curriculum/translation-quality-audit.mjs",
    "curriculum:locate": "node scripts/curriculum/locate.mjs",
    "curriculum:inventory": "node scripts/curriculum/inventory.mjs",
    "curriculum:migrate-legacy": "node scripts/curriculum/migrate-legacy.mjs",
    "curriculum:add-lesson": "node scripts/curriculum/add-lesson.mjs",
    "curriculum:export": "node scripts/curriculum/export.mjs",
    "curriculum:test": "node --test scripts/curriculum/tests/*.test.mjs",
    "i18n:audit": "node --experimental-strip-types scripts/i18n-audit.mjs",
    "international:test": "node --experimental-strip-types --test scripts/international/tests/preferences.test.ts scripts/international/tests/locale-resolution.test.ts scripts/international/tests/i18n-coverage.test.ts scripts/international/tests/route-coverage.test.ts",
    "regionalization:test": "node --experimental-strip-types --test scripts/regionalization/tests/engine.test.ts",
    "launch:readiness": "node scripts/launch-readiness.mjs",
    "verify:launch": "npm run typecheck && npm run test && npm run i18n:audit && npm run international:test && npm run regionalization:test && npm run curriculum:audit && npm run curriculum:translation-quality && npm run launch:readiness && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && mkdir -p .test-dist/node_modules && ln -sfn ../src .test-dist/node_modules/@ && node --test --test-concurrency=1 $(find .test-dist/src -name '*.test.js' -print | sort)",
    "curriculum:fix-gold-track-name": "node scripts/curriculum/fix-gold-official-track-name.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "autoprefixer": "^10.4.20",
    "next": "^15.5.19",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.20"
  }
}
